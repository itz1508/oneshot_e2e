# OneShot Workspace API local configuration.
ONESHOT_WORKSPACE_ENVIRONMENT=development
ONESHOT_WORKSPACE_APP_NAME=OneShot AI Workspace API
ONESHOT_WORKSPACE_API_PREFIX=/v1
ONESHOT_WORKSPACE_DATABASE_URL=sqlite:///./data/oneshot-workspace.db
ONESHOT_WORKSPACE_AUTO_CREATE_SCHEMA=true
ONESHOT_WORKSPACE_DATABASE_ECHO=false

# Generate independent production values; never commit the real values.
ONESHOT_WORKSPACE_JWT_SECRET=development-only-jwt-secret-change-me-now
ONESHOT_WORKSPACE_JWT_ALGORITHM=HS256
ONESHOT_WORKSPACE_ACCESS_TOKEN_TTL_MINUTES=30
ONESHOT_WORKSPACE_API_KEY_PEPPER=development-only-api-key-pepper-change-me-now
# Comma-separated Fernet keys, newest first. Required in production.
ONESHOT_WORKSPACE_ENCRYPTION_KEYS=

ONESHOT_WORKSPACE_CORS_ORIGINS=http://localhost:8787,http://localhost:3000
ONESHOT_WORKSPACE_CONTEXT_MESSAGE_LIMIT=40
ONESHOT_WORKSPACE_PROVIDER_TIMEOUT_SECONDS=120
ONESHOT_WORKSPACE_PROVIDER_MAX_RETRIES=2

# Use redis for multi-instance deployment.
ONESHOT_WORKSPACE_RATE_LIMIT_BACKEND=memory
ONESHOT_WORKSPACE_RATE_LIMIT_REQUESTS=120
ONESHOT_WORKSPACE_RATE_LIMIT_WINDOW_SECONDS=60
ONESHOT_WORKSPACE_REDIS_URL=redis://localhost:6379/1
ONESHOT_WORKSPACE_RATE_LIMIT_FAIL_OPEN=false

ONESHOT_WORKSPACE_LOG_LEVEL=INFO
ONESHOT_WORKSPACE_LOG_JSON=true
