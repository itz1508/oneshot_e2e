│ Researcher                                                  │
│  backend/agents/researcher/{agent,workflow,SKILL}.ts        │
│  tools: registry, evidence/collector, tavily/{bridge,…}     │
│  produces: Researcher(id)                                   │
│    ├── plan_id                                              │
│    ├── schema_id                                            │
│    ├── fixture_id                                           │
│    ├── goal_id                                              │
│    └── validation_id                                        │
└─────────────────────────────────────────────────────────────┘
   │
   ▼
┌─────────────────────────────────────────────────────────────┐
│ Planner                                                     │
│  backend/agents/planner/{agent,workflow,SKILL}.ts           │
│  tool: coverage                                             │
│  consumes: plan_id                                          │
