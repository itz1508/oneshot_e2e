# OneShot React IDE environment template.
# Copy this file to web/.env.local for local development.

# Optional external assistant backend exposed to browser application code.
# Must be an absolute HTTP(S) URL with no query or fragment. Use HTTPS for
# hosted backends. The value is baked into production builds.
# VITE_ASSISTANT_API_URL=https://backend.example.com

# Vite development proxy for /api and supported /v1 routes.
# ONESHOT_BACKEND_PROXY_TARGET=http://127.0.0.1:8787

# Backward-compatible fallback used only when ONESHOT_BACKEND_PROXY_TARGET is
# unset.
# ONESHOT_ASSISTANT_PROXY_TARGET=http://127.0.0.1:8787

# Vite development proxy for /v1/visual routes.
# ONESHOT_VISUAL_PROXY_TARGET=http://127.0.0.1:8000

# Never place ONESHOT_API_TOKEN or provider credentials in web environment
# files: VITE_* values are browser-visible, and the UI intentionally does not
# receive the server bearer token.
