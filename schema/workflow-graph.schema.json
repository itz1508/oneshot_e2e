{
  "$id": "urn:oneshot:schema:workflow-graph:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_ownership": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "minLength": 1,
            "type": "string"
          },
          "consumers": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "owner": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "artifact",
          "owner",
          "consumers"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "edges": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "minLength": 1,
            "type": "string"
          },
          "from": {
            "minLength": 1,
            "type": "string"
          },
          "to": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "artifact"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "nodes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "source",
              "processor",
              "validator",
              "gate",
              "proof",
              "terminal"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "parallel_groups": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "group_id": {
            "minLength": 1,
            "type": "string"
          },
          "join": {
            "minLength": 1,
            "type": "string"
          },
          "members": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "group_id",
          "members",
          "join"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "workflow_agents": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "SequentialAgent"
                }
              },
              "required": ["type"]
            },
            "then": {
              "not": {
                "anyOf": [
                  {"required": ["exit"]},
                  {"required": ["join"]}
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "LoopAgent"
                }
              },
              "required": ["type"]
            },
            "then": {
              "required": ["exit"],
              "not": {"required": ["join"]}
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "ParallelAgent"
                }
              },
              "required": ["type"]
            },
            "then": {
              "required": ["join"],
              "not": {"required": ["exit"]}
            }
          }
        ],
        "properties": {
          "exit": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "join": {
            "minLength": 1,
            "type": "string"
          },
          "members": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "type": {
            "enum": [
              "SequentialAgent",
              "LoopAgent",
              "ParallelAgent"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "members"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    },
    "workflow_id": {
      "const": "oneshot-canonical-workflow",
      "type": "string"
    }
  },
  "required": [
    "workflow_id",
    "version",
    "nodes",
    "edges",
    "artifact_ownership",
    "parallel_groups",
    "workflow_agents"
  ],
  "type": "object"
}
