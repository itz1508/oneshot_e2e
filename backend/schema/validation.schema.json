            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "fixture_id": {
          "minLength": 1,
          "type": "string"
        },
        "plan_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "fixture_id",
        "assertion_ids"
      ],
      "type": "object"
    },
    "goal_validation": {
      "additionalProperties": false,
      "properties": {
        "criterion_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
