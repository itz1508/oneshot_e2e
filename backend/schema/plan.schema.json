        "type": "object"
      },
      "type": "array"
    },
    "researcher_id": {
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "revision_evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "affected_area": {
            "minLength": 1,
            "type": "string"
