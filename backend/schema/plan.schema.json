            "uniqueItems": true
          },
          "responsibility": {
            "minLength": 1,
            "type": "string"
          },
          "schema_refs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
