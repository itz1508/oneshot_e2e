          "description": {
            "minLength": 1,
            "type": "string"
          },
          "required_by": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "dependency_id",
          "description",
          "required_by"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "plan_id": {
      "minLength": 1,
      "type": "string"
    },
    "requirements": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "requirement_id": {
            "minLength": 1,
            "type": "string"
          },
          "statement": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "requirement_id",
