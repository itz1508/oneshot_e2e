{
  "$id": "urn:oneshot:schema:evaluation:2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "Passed"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "root_cause",
            "issue_type"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "Failed"
          }
        }
      },
      "then": {
        "required": ["root_cause", "issue_type"]
      }
    }
  ],
  "properties": {
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "minLength": 1,
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "finding": {
            "minLength": 1,
            "type": "string"
          },
          "subject": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "check_id",
          "subject",
          "finding",
          "evidence_ids"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "plan_id": {
      "minLength": 1,
      "type": "string"
    },
    "result": {
      "$ref": "urn:oneshot:schema:common:2#/$defs/test_result"
    },
    "issue_type": {
      "$ref": "urn:oneshot:schema:common:2#/$defs/issue_type"
    },
    "root_cause": {
      "$ref": "urn:oneshot:schema:common:2#/$defs/root_cause"
    }
  },
  "required": [
    "plan_id",
    "result",
    "evidence"
  ],
  "type": "object"
}
