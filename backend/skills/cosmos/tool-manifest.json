{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "skill_id": "strands-cosmos",
  "groups": ["vision", "generate", "action", "curate", "deploy", "evaluate", "system"],
  "tools": [
    {
      "name": "cosmos_reason",
      "group": "vision",
      "description": "Reason over video and/or images with the Cosmos3 reasoner and return text.",
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string" },
          "media": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["prompt"]
      }
    },
    {
      "name": "cosmos_vision",
      "group": "vision",
      "description": "Run the Cosmos-Reason2 VLM over video/images and return text.",
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string" },
          "media": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["prompt", "media"]
      }
    },
    {
      "name": "cosmos_generate_video",
      "group": "generate",
      "description": "Generate video/audio/image with the Cosmos3 generator.",
      "input_schema": {
        "type": "object",
        "properties": {
          "mode": { "type": "string", "enum": ["text2video", "text2video-with-sound", "image2video", "image", "audio"] },
          "prompt": { "type": "string" },
          "image_path": { "type": "string" },
          "out_path": { "type": "string" }
        },
        "required": ["mode", "prompt", "out_path"]
      }
    }
  ]
}
