# ==============================================================================
# OneShot Production E2E — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and configure as needed.
# All values shown below are default placeholders; no secret keys are included.

# ── Core Runtime & HTTP Server ───────────────────────────────────────────────
PORT=8787
ONESHOT_MODE=sample
# ONESHOT_ROOT=.
# ONESHOT_PYTHON=python

# ── Provider Selection ────────────────────────────────────────────────────────
# Mode: "sample" uses deterministic FixtureResearchProvider (no keys needed).
# Mode: "production" resolves provider via ONESHOT_RESEARCH_PROVIDER.
#
# Supported production providers:
#   1. Google ADK + Gemma 2 (Local Ollama daemon)
#      ONESHOT_RESEARCH_PROVIDER=adk_gemma2
#
#   2. Featherless AI (OpenAI-compatible Cloud API)
#      ONESHOT_RESEARCH_PROVIDER=featherless
#
#   3. Custom module exporting createResearchProvider() or default provider
#      ONESHOT_RESEARCH_PROVIDER_MODULE=./providers/custom-provider.js

# ── Featherless Provider Configuration (when using featherless) ───────────────
# FEATHERLESS_API_KEY=your_featherless_api_key_here
# FEATHERLESS_MODEL=google/gemma-4-31B-it
# FEATHERLESS_API_BASE=https://api.featherless.ai/v1
# FEATHERLESS_NUM_PARALLEL=2
# FEATHERLESS_TIMEOUT_SECONDS=300
# FEATHERLESS_MAX_TOKENS=4096
# FEATHERLESS_APP_URL=

# ── Google ADK + Gemma 2 Provider Configuration (when using adk_gemma2) ───────
# GEMMA2_LOCAL_MODEL=gemma2:9b
# OLLAMA_API_BASE=http://localhost:11434
# GEMMA2_NUM_PARALLEL=2
# REDIS_URL=

# ── Hardened Sandbox Runtime Policies ─────────────────────────────────────────
# SANDBOX_TIMEOUT_SECONDS=300
# SANDBOX_MEMORY_LIMIT=512
# SANDBOX_CPU_LIMIT=1.0
# SANDBOX_PID_LIMIT=64
# SANDBOX_NETWORK_POLICY=DENY_ALL
# SANDBOX_MAX_FILES_CHANGED=100
# SANDBOX_MAX_TOTAL_BYTES_WRITTEN=10485760

# ── HTTP Security & Rate Limiting ─────────────────────────────────────────────
# CORS_ORIGIN=http://localhost:8787
# ONESHOT_API_TOKEN=
# API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=100
