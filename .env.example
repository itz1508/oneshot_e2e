# ==============================================================================
# OneShot Production E2E — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and configure as needed.
# All values shown below are default placeholders; no secret keys are included.

# ── Core Runtime & HTTP Server ───────────────────────────────────────────────
PORT=8787
ONESHOT_BIND_HOST=127.0.0.1
ONESHOT_MODE=sample
ONESHOT_ROOT=.
ONESHOT_WORKSPACE_ROOT=.
ONESHOT_NO_OPEN=0
# ONESHOT_PYTHON=python

# ── Provider Selection ────────────────────────────────────────────────────────
# Mode: "sample" uses deterministic FixtureResearchProvider (no keys needed).
# Mode: "production" requires an explicit ONESHOT_RESEARCH_PROVIDER binding.
# There is no silent production provider fallback.
#
# Supported production providers:
#   1. Google ADK Researcher pipeline + local Ollama models
#      ONESHOT_RESEARCH_PROVIDER=adk_gemma2
#
#   2. Featherless AI (OpenAI-compatible Cloud API)
#      ONESHOT_RESEARCH_PROVIDER=featherless
#
#   3. Custom module exporting createResearchProvider() or default provider.
#      Custom providers must implement ready(runId) and research(prompt, runId).
#      ONESHOT_RESEARCH_PROVIDER_MODULE=./providers/custom-provider.js

# ── Optional Local Research Evidence ──────────────────────────────────────────
# ONESHOT_RESEARCH_EVIDENCE_FILES=README.md,docs/WORKFLOW_TREE
# ONESHOT_RESEARCH_EVIDENCE_ROOTS=.
# ONESHOT_RESEARCH_EVIDENCE_MAX_BYTES=16384

# ── Featherless Provider Configuration (when using featherless) ───────────────
# FEATHERLESS_API_KEY=your_featherless_api_key_here
# FEATHERLESS_MODEL=google/gemma-4-31B-it
# FEATHERLESS_API_BASE=https://api.featherless.ai/v1
# FEATHERLESS_NUM_PARALLEL=2
# FEATHERLESS_TIMEOUT_SECONDS=300
# FEATHERLESS_MAX_TOKENS=4096
# FEATHERLESS_APP_URL=

# ── Google ADK Researcher Pipeline (when using adk_gemma2) ───────────────────
# Production requires THREE explicit and distinct model bindings.
# OneShot does not choose the model IDs for you.
#
# Distribution: decides research focus/evidence routing.
# GEMMA2_DISTRIBUTION_MODEL=
#
# Research: produces the evidence-backed research candidate.
# GEMMA2_RESEARCH_MODEL=
#
# Synthesis: produces the final structured ResearchDraft.
# GEMMA2_SYNTHESIS_MODEL=
#
# GEMMA2_LOCAL_HOST=localhost
# GEMMA2_LOCAL_PORT=11434
# OLLAMA_API_BASE=http://localhost:11434
# GEMMA2_NUM_PARALLEL=2
# GEMMA2_TIMEOUT_SECONDS=300
# GEMMA2_AUTO_PULL=false
# REDIS_URL=
# CACHE_URL=
# CACHE_TTL=3600

# ── Hardened Sandbox Runtime Policies ─────────────────────────────────────────
# ONESHOT_SANDBOX_RUNNER=process
# ONESHOT_SANDBOX_IMAGE=oneshot-sandbox-worker:latest
# DOCKER_BIN=docker
# SANDBOX_TIMEOUT_SECONDS=300
# SANDBOX_MEMORY_LIMIT=512
# SANDBOX_CPU_LIMIT=1.0
# SANDBOX_PID_LIMIT=64
# SANDBOX_NETWORK_POLICY=DENY_ALL
# SANDBOX_ENVIRONMENT_ALLOWLIST=NODE_ENV,PATH
# SANDBOX_MAX_OUTPUT_BYTES=1048576
# SANDBOX_MAX_FILES_CHANGED=100
# SANDBOX_MAX_TOTAL_BYTES_WRITTEN=10485760

# ── HTTP Security & Rate Limiting ─────────────────────────────────────────────
# Non-loopback ONESHOT_BIND_HOST values require ONESHOT_API_TOKEN.
# CORS_ORIGIN=http://localhost:8787
# ONESHOT_API_TOKEN=
# API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=100

# ── Verification Profile Selection ───────────────────────────────────────────
# ONESHOT_WORKSPACE_API=true
