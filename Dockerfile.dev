# Development image for the OneShot TypeScript backend.
#
# Usage:
#   docker compose -f docker-compose.dev.yml up --build -d
#
# The image installs dependencies and builds the backend once. The compose
# file then runs two containers from it: the HTTP API server and the BullMQ
# worker, so a stage crash cannot kill the API.

FROM node:22-alpine
WORKDIR /app

COPY package*.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build:backend

EXPOSE 8787
CMD ["node", "dist/backend/index.js"]
