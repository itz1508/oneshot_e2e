# Optional remote ResearchProvider: Featherless-hosted Gemma 4
ONESHOT_MODE=production
ONESHOT_RESEARCH_PROVIDER=featherless
ONESHOT_BIND_HOST=127.0.0.1
# ONESHOT_API_TOKEN=
FEATHERLESS_API_BASE=https://api.featherless.ai/v1
FEATHERLESS_MODEL=google/gemma-4-31B-it
FEATHERLESS_API_KEY=
FEATHERLESS_NUM_PARALLEL=2
FEATHERLESS_TIMEOUT_SECONDS=300
FEATHERLESS_MAX_TOKENS=4096

# Optional attribution URL sent as HTTP-Referer by the server-side client.
# FEATHERLESS_APP_URL=http://localhost:8787

# Python executable containing requirements/core.txt + requirements/provider-featherless.txt.
# ONESHOT_PYTHON=python
