# Google ADK + local Gemma 2 through Ollama
ONESHOT_MODE=production
ONESHOT_RESEARCH_PROVIDER=adk_gemma2
GEMMA2_LOCAL_MODEL=gemma2:9b
GEMMA2_LOCAL_HOST=localhost
GEMMA2_LOCAL_PORT=11434
OLLAMA_API_BASE=http://localhost:11434
GEMMA2_AUTO_PULL=true
GEMMA2_NUM_PARALLEL=2
GEMMA2_TIMEOUT_SECONDS=300

# Prior local performance profile
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=2

# Non-canonical research-draft cache only
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# HTTP boundary
CORS_ORIGIN=http://localhost:8787
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100
# ONESHOT_API_TOKEN=
