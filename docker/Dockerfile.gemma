# OneShot Docker Image with Ollama + Gemma Support
# Usage: docker run -p 8787:8787 -p 11434:11434 -e ONESHOT_RESEARCH_PROVIDER=ollama oneshot:latest

FROM node:24.13.0-slim AS node-builder
WORKDIR /app

# Install root runtime + build dependencies
COPY package*.json tsconfig.json ./
COPY app/vendor ./app/vendor
RUN npm install --ignore-scripts --no-audit --no-fund

# Copy backend source and compile
COPY backend ./backend
COPY app/web/cloud ./app/web/cloud
RUN npx tsc -p tsconfig.json

# Copy and build OneShot Web IDE
COPY app/web ./app/web
RUN cd app/web && npm ci --no-audit --no-fund && npm run build

# Prune development dependencies
RUN npm prune --omit=dev --no-audit --no-fund

# ==========================================
# Final Runtime Image
# ==========================================
FROM python:3.12-slim-bookworm AS runner
WORKDIR /app

# Install runtime dependencies (zstd is required to unpack the Ollama archive
# at first container startup, see scripts/docker-entrypoint-gemma.sh)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    zstd \
    && rm -rf /var/lib/apt/lists/*

# NOTE: The Ollama runtime is intentionally NOT installed at build time. The
# ~1.2GB tarball (~4GB extracted) crashed the Docker buildkit daemon on this
# Windows/WSL2 setup (6GB VM memory cap) on every attempt. The entrypoint
# streams `curl | tar` into /opt/ollama at first container startup instead
# (cached in the `ollama_runtime` named volume). Same pattern as the model:
# models are also NOT baked in — the local model cache is bind-mounted at
# runtime:
#   -v ./.ollama/models:/root/.ollama/models
# The entrypoint installs Ollama and pulls $OLLAMA_MODEL automatically.

# Use exact Node runtime from Node build stage
COPY --from=node-builder /usr/local/bin/node /usr/local/bin/node
COPY --from=node-builder /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && node --version \
    && npm --version

# Install Python dependencies
COPY app/requirements ./app/requirements
RUN pip install --no-cache-dir -r app/requirements/base.txt

# Copy runtime dependencies
COPY package*.json ./
COPY --from=node-builder /app/node_modules ./node_modules

# Copy compiled backend and Web IDE
COPY --from=node-builder /app/dist ./dist
COPY --from=node-builder /app/app/web/dist ./app/web/dist
COPY backend ./backend
COPY app/web/cloud ./app/web/cloud
COPY app/web/__init__.py ./app/web/__init__.py

# Copy fixtures and legal docs
COPY app/fixtures ./app/fixtures
COPY app/legal ./app/legal
COPY docs/CANONICAL_WORKFLOW.md ./docs/CANONICAL_WORKFLOW.md
COPY docs/license/LICENSE docs/license/NOTICE ./docs/license/

# Python import paths
ENV PYTHONPATH=/app/backend/validation/python:/app/app

# Create runtime directories
RUN mkdir -p .runtime/runs .runtime/run-state .runtime/task-events .runtime/checkpoints \
    .runtime/conversations .runtime/sandbox-workspaces .runtime/cache .runtime/uploads .runtime/qc

# ==========================================
# Configuration & Startup
# ==========================================

# OneShot HTTP Server
# 0.0.0.0 is REQUIRED inside the container so the published port
# (docker -p / compose ports:) can forward traffic from the host.
ENV ONESHOT_BIND_HOST=0.0.0.0
ENV PORT=8787
ENV NODE_ENV=production
ENV ONESHOT_MODE=production
ENV ONESHOT_API_TOKEN=

# Research Provider - default to local Gemma via Ollama (user can override)
ENV ONESHOT_RESEARCH_PROVIDER=ollama

# Ollama configuration (local, in-container)
ENV OLLAMA_MODEL=gemma2:2b
ENV OLLAMA_HOST=127.0.0.1:11434
ENV OLLAMA_MODELS=/root/.ollama/models

# Optional: Cloud API keys (users can set via docker run -e)
# ENV FEATHERLESS_API_KEY=your_key_here
# ENV GEMINI_API_KEY=your_key_here

EXPOSE 8787

# Startup script: installs Ollama on first run (streamed, low peak memory),
# starts Ollama, ensures the Gemma model is loaded,
# seeds the provider config so the production ProviderManager routes
# research requests to local Gemma, then execs the OneShot server.
COPY scripts/docker-entrypoint-gemma.sh /scripts/entrypoint.sh
RUN chmod +x /scripts/entrypoint.sh

CMD ["/scripts/entrypoint.sh"]
