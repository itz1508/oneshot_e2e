{
  "name": "oneshot-frontend",
  "version": "1.3.0",
  "description": "OneShot canonical Next.js frontend with AG-UI streaming, context review, and provider switching",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check.mjs lint",
    "check": "node scripts/check.mjs lint",
    "test": "node --import tsx --test \"tests/**/*.test.mjs\"",
    "build": "next build --webpack && node scripts/export.mjs",
    "dev": "next dev --webpack -p 5173",
    "preview": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
