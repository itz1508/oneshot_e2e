{
  "name": "oneshot-frontend",
  "version": "1.3.0",
  "description": "OneShot canonical Next.js frontend with AG-UI streaming, context review, and provider switching",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check.mjs lint",
    "check": "node scripts/check.mjs lint",
    "test": "node --import tsx --test \"tests/**/*.test.mjs\"",
    "build": "next build --webpack && node scripts/export.mjs",
    "dev": "next dev --webpack -p 5173",
    "preview": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3",
    "lucide-react": "^0.545.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "5.8.3",
    "@types/node": "^24.0.4"
  }
}
