# Dependencies
node_modules/
app/integration/*/node_modules/
frontend/web/node_modules/

# Build and export outputs
dist/
build/
out/
.next/
frontend/web/.next/
frontend/web/dist/
frontend/web/out/
*.tsbuildinfo


# Deployment tooling
# .vercel/project.json pins the linked Vercel project/org by id. It is
# machine-local and must never be committed.
.vercel/

# Environment and secrets
# These patterns contain no slash, so git matches them at EVERY level: repo
# root, app/env/, backend/, frontend/web/, e2e/, and any new package added.
# `.env.*` is what covers per-environment variants; the previous rules only
# handled `.env` and `.env.local`, so a `.env.production` or `.env.development`
# would have been committed.
.env
.env.*
.envrc

# Templates are documentation and are intentionally tracked.
!.env.example
!.env.*.example

# Private key material and cloud credentials.
# Nothing tracked in this repository matches these; the templates above are the
# only credential-shaped files that belong in version control.
*.pem
*.key
*.p12
*.pfx
service-account*.json
*serviceAccount*.json
*credentials*.json

# Logs and test artifacts
*.log
*.tmp
*.temp
server.log
server-err.log
test-results/
screenshots/
artifacts/
demo-artifacts/
coverage/
.nyc_output/
test.txt
test-api.mjs

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/

# OS and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
.kiro/
.oneshot/

public/demo/page@*.webm
debug-screenshot.png

*.egg-info/
