FROM python:3.12-slim-bookworm

# Non-root user
RUN groupadd -g 10001 sandbox && \
    useradd -u 10001 -g sandbox -m -s /bin/sh sandbox

# Prepare directories
RUN mkdir -p /input /work /output && \
    chown -R sandbox:sandbox /input /work /output

USER sandbox:sandbox
WORKDIR /work

CMD ["python", "-c", "print('ONESHOT_SANDBOX_WORKER_READY')"]
