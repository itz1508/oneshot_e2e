# OneShot External Sandbox Configuration
ONESHOT_SANDBOX_RUNNER=container
ONESHOT_SANDBOX_IMAGE=oneshot-sandbox-worker:latest
DOCKER_BIN=docker

# Resource limits
SANDBOX_MEMORY_LIMIT=512
SANDBOX_CPU_LIMIT=1.0
SANDBOX_PID_LIMIT=64
SANDBOX_TIMEOUT_SECONDS=300

# Policy
SANDBOX_NETWORK_POLICY=DENY_ALL
SANDBOX_ENVIRONMENT_ALLOWLIST=NODE_ENV,PATH

# Output bounds
SANDBOX_MAX_OUTPUT_BYTES=1048576
SANDBOX_MAX_FILES_CHANGED=100
SANDBOX_MAX_TOTAL_BYTES_WRITTEN=10485760
