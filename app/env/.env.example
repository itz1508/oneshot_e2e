# ONESHOT_WORKSPACE_REDIS_URL="redis://localhost:6379/1"

# Optional settings from featherless.env.example; enable only for the selected service.
# FEATHERLESS_API_BASE="https://api.featherless.ai/v1"
# FEATHERLESS_API_KEY=""
# FEATHERLESS_MAX_TOKENS=""
# FEATHERLESS_MODEL="google/gemma-4-31B-it"
# FEATHERLESS_NUM_PARALLEL="2"
# FEATHERLESS_TIMEOUT_SECONDS="300"
# ONESHOT_LEGACY_PROVIDER_ENABLED="true"

