# ==============================================================================
# OneShot Production E2E — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to app/env/.env and configure as needed.
# All values shown below are default placeholders; no secret keys are included.

# ── Core Runtime & HTTP Server ───────────────────────────────────────────────
PORT=8787
ONESHOT_BIND_HOST=127.0.0.1
ONESHOT_MODE=production
ONESHOT_ROOT=.
ONESHOT_WORKSPACE_ROOT=.
ONESHOT_NO_OPEN=0
# ONESHOT_PYTHON=python
# ONESHOT_RUNTIME_DIR=.runtime

# ── Redis / BullMQ Run Queue (optional) ──────────────────────────────────────
# When Redis is unreachable, OneShot logs ONESHOT_QUEUE_REDIS_UNAVAILABLE and
# executes runs inline in-process (fully functional without Redis).
# Formats: redis://[:password@]host[:port][/db]  ·  rediss://... for TLS
# REDIS_URL=redis://127.0.0.1:6379
# ONESHOT_RUN_CONCURRENCY=1
# ONESHOT_QUEUE_READY_TIMEOUT=8000



# ── Optional Local Research Evidence ──────────────────────────────────────────
# ONESHOT_RESEARCH_EVIDENCE_FILES=README.md,docs/WORKFLOW_TREE
# ONESHOT_RESEARCH_EVIDENCE_ROOTS=.
# ONESHOT_RESEARCH_EVIDENCE_MAX_BYTES=16384

# ── Optional Tavily Researcher Evidence ───────────────────────────────────────
# Tavily augments Researcher evidence; it does NOT replace ONESHOT_RESEARCH_PROVIDER.
# Supplying TAVILY_API_KEY enables search-extract mode by default.
# TAVILY_API_KEY=
# ONESHOT_TAVILY_MODE=search-extract
# Supported modes: off | search | search-extract | research-stream
# ONESHOT_TAVILY_REQUIRED=false
# TAVILY_SEARCH_DEPTH=advanced
# TAVILY_MAX_RESULTS=5
# TAVILY_EXTRACT_TOP_N=3
# TAVILY_EXTRACT_DEPTH=basic
# TAVILY_RESEARCH_MODEL=mini
# TAVILY_TIMEOUT_SECONDS=180
# ONESHOT_TAVILY_MAX_EVIDENCE_BYTES=12000

# ── OpenAI Provider Configuration (when using openai) ─────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_NUM_PARALLEL=2
# OPENAI_TIMEOUT_SECONDS=300
# OPENAI_MAX_TOKENS=4096
# OPENAI_APP_URL=

# ── Anthropic Provider Configuration (when using anthropic) ───────────────────
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_BASE=https://api.anthropic.com/v1
# ANTHROPIC_NUM_PARALLEL=2
# ANTHROPIC_TIMEOUT_SECONDS=300
# ANTHROPIC_MAX_TOKENS=4096

# ── Gemini Provider Configuration (when using gemini) ──────────────────────────
# Production requires THREE explicit and distinct model bindings.
# The established hackathon proof bindings are shown below.
#
# Distribution: decides research focus/evidence routing.
GEMINI_DISTRIBUTION_MODEL=gemini-3.5-flash-lite
# Research: produces the evidence-backed research candidate.
GEMINI_RESEARCH_MODEL=gemini-3.6-flash
# Synthesis: produces the final structured ResearchDraft.
GEMINI_SYNTHESIS_MODEL=gemini-3.7-flash
#
# Preferred cloud/local-ADC backend: Vertex AI.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=true
#
# Gemini API alternative (do not commit a real key):
# GOOGLE_GENAI_USE_VERTEXAI=false
# GEMINI_API_KEY=
#
# GEMINI_NUM_PARALLEL=2
# GEMINI_TIMEOUT_SECONDS=300
# GEMINI_REFINEMENT_ATTEMPTS=3
# GEMINI_MAX_OUTPUT_TOKENS=3072
# REDIS_URL=
# CACHE_URL=
# CACHE_TTL=3600

# ── Hardened Sandbox Runtime Policies ─────────────────────────────────────────
# ONESHOT_SANDBOX_RUNNER=process
# ONESHOT_SANDBOX_IMAGE=oneshot-sandbox-worker:latest
# DOCKER_BIN=docker
# SANDBOX_TIMEOUT_SECONDS=300
# SANDBOX_MEMORY_LIMIT=512
# SANDBOX_CPU_LIMIT=1.0
# SANDBOX_PID_LIMIT=64
# SANDBOX_NETWORK_POLICY=DENY_ALL
# SANDBOX_ENVIRONMENT_ALLOWLIST=NODE_ENV,PATH
# SANDBOX_MAX_OUTPUT_BYTES=1048576
# SANDBOX_MAX_FILES_CHANGED=100
# SANDBOX_MAX_TOTAL_BYTES_WRITTEN=10485760

# ── HTTP Security & Rate Limiting ─────────────────────────────────────────────
# Non-loopback ONESHOT_BIND_HOST values require ONESHOT_API_TOKEN.
# CORS_ORIGIN=http://localhost:8787
# ONESHOT_API_TOKEN=
# API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=100

# ── Verification Profile Selection ───────────────────────────────────────────
# ONESHOT_WORKSPACE_API=true

