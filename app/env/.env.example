# GEMINI_MAX_OUTPUT_TOKENS=""
# GEMINI_NUM_PARALLEL="1"
# GEMINI_REFINEMENT_ATTEMPTS="3"
# GEMINI_TIMEOUT_SECONDS="900"
# GOOGLE_CLOUD_LOCATION="global"
# GOOGLE_CLOUD_PROJECT="your-project-id"
# GOOGLE_GENAI_USE_VERTEXAI="true"

# Optional settings from judge.env.example; enable only for the selected service.

# Optional settings from sandbox.env.example; enable only for the selected service.
# DOCKER_BIN="docker"
# ONESHOT_SANDBOX_IMAGE="oneshot-sandbox-worker:latest"
# ONESHOT_SANDBOX_RUNNER="container"
# SANDBOX_CPU_LIMIT="1.0"
# SANDBOX_ENVIRONMENT_ALLOWLIST="NODE_ENV,PATH"
# SANDBOX_MAX_FILES_CHANGED="100"
# SANDBOX_MAX_OUTPUT_BYTES="1048576"
# SANDBOX_MAX_TOTAL_BYTES_WRITTEN="10485760"
# SANDBOX_MEMORY_LIMIT="512"
# SANDBOX_NETWORK_POLICY="DENY_ALL"
# SANDBOX_PID_LIMIT="64"
# SANDBOX_TIMEOUT_SECONDS="300"

# Cloud queue connection (external URL for local development; keep credentials private).
# REDIS_URL=rediss://default:password@hostname:6379
# ONESHOT_START_WORKER=true
# Tests may override NODE_ENV=test and ONESHOT_API_TOKEN in their process environment.
