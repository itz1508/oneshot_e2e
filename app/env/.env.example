# ==============================================================================
# OneShot Multi-Provider Environment Configuration Template
# Modeled after LangChain.js & OpenAPI standard multi-provider specifications.
#
# All providers feature PREBUILT PRESETS:
# When testing, you only need to supply your API key. Endpoints, default models,
# and streaming protocols are pre-configured out of the box.
# ==============================================================================

# ── 1. Mistral AI (Prebuilt Test Preset & OpenAI Replacement) ─────────────────
# Direct Mistral API (or use in place of OpenAI via OpenAPI chat completions):
# Preset defaults: model=mistral-large-latest, endpoint=https://api.mistral.ai/v1
# Get key: https://console.mistral.ai/
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ── 2. Google Gemini API (Recommended Default) ────────────────────────────────
# Preset defaults: model=gemini-2.5-flash
# Get key free: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── 3. OpenAI & Azure OpenAI ──────────────────────────────────────────────────
# Standard OpenAI or Azure OpenAI endpoint:
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_INSTANCE_NAME=
# AZURE_OPENAI_API_DEPLOYMENT_NAME=
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ── 4. Anthropic Claude ───────────────────────────────────────────────────────
# Get key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── 5. Nebius AI Studio ───────────────────────────────────────────────────────
# Preset defaults: model=moonshotai/Kimi-K2.5, endpoint=https://api.studio.nebius.com/v1/
# Get key: https://studio.nebius.ai/
# NEBIUS_API_KEY=
# NEBIUS_MODEL=moonshotai/Kimi-K2.5

# ── 6. Vercel AI Gateway ──────────────────────────────────────────────────────
# Supports vck_... prefixed credentials routing to Mistral, OpenAI, etc.
# AI_GATEWAY_API_KEY=

# ── 7. Local & Self-Hosted LLMs (NO API KEY REQUIRED) ─────────────────────────
# Ollama local inference (default endpoint: http://localhost:11434/v1)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
# LM Studio / LocalAI inference
# LOCAL_AI_BASE_URL=http://localhost:1234/v1

# ── 8. Python Reasoning Engine (Offline Autonomous Reasoning) ─────────────────
# Standalone Python reasoning engine (backend/python/) for zero-API testing.
PYTHON_REASONING_ENABLED=true
# Optional standalone HTTP daemon URL (defaults to in-process CLI execution)
# PYTHON_REASONING_URL=http://localhost:8000
# PYTHON_PATH=python

# ── 9. Research & Verification Tools ──────────────────────────────────────────
# Tavily Search API for researcher workflows:
# Get key: https://tavily.com/
# TAVILY_API_KEY=

# ── 10. Server & Networking ───────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# ── 11. Google OAuth (Optional login) ─────────────────────────────────────────
# Get OAuth credentials: https://console.cloud.google.com/apis/credentials
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback

# ── 12. Optional Local Tooling Paths ─────────────────────────────────────────
# Keep machine-specific values out of tracked source files.
ONESHOT_DEMO_URL=http://127.0.0.1:8787
ONESHOT_DEMO_OUTPUT_DIR=public/demo
ONESHOT_DEMO_ARTIFACT_DIR=test-results/demo
ONESHOT_BROWSER_EXECUTABLE=