# ==============================================================================
# OneShot Production 1.3.0 - Judge Environment Configuration
# ==============================================================================
# Network binding and port
ONESHOT_BIND_HOST=0.0.0.0
PORT=8787

# Local OneShot container access token.
# IMPORTANT: This is NOT an external/provider API key. It is simply a local secret
# string that both the container and judge know to secure the web session.
# Example: ONESHOT_API_TOKEN=oneshot-judge-2026-random-secret
# (If using .\start-oneshot.ps1 or ./start-oneshot.sh, this is auto-generated for you)
ONESHOT_API_TOKEN=oneshot-judge-2026-random-secret
