{
  "name": "oneshot-production-e2e",
  "version": "1.3.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.13.0",
    "npm": ">=11.8.0"
  },
  "scripts": {
    "oneshot": "node scripts/oneshot.mjs",
    "agent:review": "npm run build:backend && node dist/app/bootstrap/readme.js",
    "build": "tsc -p tsconfig.json && npm --prefix app/web run build",
    "start": "node dist/backend/index.js",
    "test": "npm run build:backend && tsc -p tsconfig.test.json && node --test --test-concurrency=1 --test-force-exit dist/backend/test/ts/*.test.js",
    "build:test": "tsc -p tsconfig.test.json",
    "demo": "node app/bootstrap/demo.mjs",
    "setup": "node -e \"require('child_process').execSync(process.platform==='win32'?'app/bootstrap/setup.bat':'bash app/bootstrap/setup.sh',{stdio:'inherit'})\"",
    "verify": "python app/scripts/verify_all.py",
    "verify:adk-adapter": "npm run build && node --test --test-force-exit dist/backend/test/ts/adk-gemma-provider.test.js",
    "verify:featherless-adapter": "npm run build && node --test --test-force-exit dist/backend/test/ts/featherless-provider.test.js",
    "verify:featherless-live": "npm run build && node scripts/e2e/scripts/verify_featherless_live.mjs",
    "preflight:ollama": "python backend/scripts/ollama_preflight.py",
    "verify:adk-live": "python scripts/e2e/scripts/verify_adk_live.py",
    "build:backend": "tsc -p tsconfig.json",
    "build:ui": "npm --prefix app/web run build"
  },
  "dependencies": {
    "@google/adk": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "file:app/vendor/npm/types-node-24.0.4.tgz",
    "typescript": "file:app/vendor/npm/typescript-5.8.3.tgz",
    "undici-types": "file:app/vendor/npm/undici-types-7.8.0.tgz"
  }
}
