{
  "name": "oneshot-production-e2e",
  "version": "1.3.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=11.27.1"
  },
  "bin": {
    "oneshot": "./scripts/oneshot.mjs"
  },
  "scripts": {
    "postinstall": "pnpm install --prefix app/integration/gemini --ignore-scripts",
    "setup:python": "node scripts/setup-python.mjs",
    "setup:python:check": "node scripts/setup-python.mjs --check",
    "lint:python": "uv run --frozen --group dev --project backend/python ruff check backend/python",
    "format:python": "uv run --frozen --group dev --project backend/python ruff format --check backend/python",
    "test:python": "uv run --frozen --project backend/python pytest backend/python/tests -q",
    "oneshot": "node scripts/oneshot.mjs",
    "dev": "node --import tsx backend/index.ts",
    "check:ui-build": "node scripts/check-ui-build.mjs",
    "preserve:serve": "node scripts/check-ui-build.mjs && node dist/backend/index.js",
    "serve": "node scripts/check-ui-build.mjs && node dist/backend/index.js",
    "prestart": "node scripts/check-ui-build.mjs",
    "start": "node dist/backend/index.js",
    "build": "pnpm run build:backend && pnpm run build:ui",
    "build:backend": "node --max-semi-space-size=16 --max-old-space-size=1024 ./node_modules/typescript/bin/tsc -p tsconfig.json --outDir dist --noEmit false",
    "build:ui": "pnpm --prefix frontend/web run build",
    "test": "pnpm run build:backend && pnpm run build:test && node --test --test-concurrency=1 --test-force-exit dist/backend/tests/ts/*.test.js",
    "pretest": "pnpm run clean:dist",
    "clean:dist": "node --eval \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "test:runtime": "node --import tsx --test --test-concurrency=1 packages/agent-runtime/tests/*.test.mjs",
    "test:scripts": "node --test --test-force-exit scripts/tests/*.test.mjs",
    "test:web": "pnpm --prefix frontend/web test",
    "test:all": "pnpm test && pnpm run test:runtime && pnpm run test:scripts && pnpm run test:web",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "pretest:e2e": "pnpm --prefix frontend/web run build",
    "build:test": "node --max-semi-space-size=16 --max-old-space-size=1024 ./node_modules/typescript/bin/tsc -p tsconfig.test.json",
    "verify": "python app/scripts/verify_all.py",
    "verify:demo": "node scripts/verify-demo-assets.mjs",
    "dry-run": "node scripts/dry-run.mjs",
    "test:dry-run": "node scripts/dry-run.mjs",
    "capture:demo": "node scripts/capture-demo.mjs",
    "preview": "pnpm --prefix frontend/web run preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@strands-agents/sdk": "^1.19.0",
    "@tavily/core": "^0.7.13",
    "ai": "^7.0.114",
    "ajv": "^8.20.0",
    "bullmq": "^6.3.8",
    "dotenv": "^18.0.3",
    "ioredis": "^6.0.0",
    "openai": "^6.49.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "24.13.6",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "undici-types": "7.29.1"
  }
}
