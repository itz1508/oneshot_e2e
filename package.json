{
  "name": "oneshot-production-e2e",
  "version": "1.3.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "oneshot": "node oneshot.mjs",
    "build": "tsc -p tsconfig.json && npm --prefix web run build",
    "start": "node dist/backend/index.js",
    "test": "npm run build && node --test dist/tests_ts/*.test.js",
    "demo": "node demo.mjs",
    "setup": "node -e \"require('child_process').execSync(process.platform==='win32'?'setup.bat':'bash setup.sh',{stdio:'inherit'})\"",
    "verify": "python scripts/verify_all.py",
    "verify:adk-adapter": "npm run build && node --test --test-force-exit dist/tests_ts/adk-gemma-provider.test.js",
    "verify:featherless-adapter": "npm run build && node --test --test-force-exit dist/tests_ts/featherless-provider.test.js",
    "verify:featherless-live": "npm run build && node scripts/verify_featherless_live.mjs",
    "preflight:ollama": "python scripts/ollama_preflight.py",
    "verify:adk-live": "python scripts/verify_adk_live.py",
    "build:backend": "tsc -p tsconfig.json",
    "build:ui": "npm --prefix web run build",
    "view:video": "node scripts/view_video.mjs"
  },
  "devDependencies": {
    "@types/node": "file:vendor/npm/types-node-24.0.4.tgz",
    "typescript": "file:vendor/npm/typescript-5.8.3.tgz",
    "undici-types": "file:vendor/npm/undici-types-7.8.0.tgz"
  }
}
