{
  "name": "oneshot-production-e2e",
  "version": "1.3.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.13.0",
    "npm": ">=11.8.0"
  },
  "bin": {
    "oneshot": "./scripts/oneshot.mjs"
  },
  "scripts": {
    "postinstall": "pnpm install --prefix app/integration/gemini --ignore-scripts",
    "oneshot": "node scripts/oneshot.mjs",
    "dev": "node --import tsx backend/index.ts",
    "serve": "node dist/backend/index.js",
    "start": "node dist/backend/index.js",
    "build": "pnpm run build:backend && pnpm run build:ui",
    "build:backend": "node --max-semi-space-size=16 --max-old-space-size=1024 ./node_modules/typescript/bin/tsc -p tsconfig.json --outDir dist --noEmit false",
    "build:ui": "pnpm --prefix frontend/web run build",
    "test": "pnpm run build:backend && pnpm run build:test && node --test --test-concurrency=1 --test-force-exit dist/backend/tests/ts/*.test.js",
    "test:runtime": "node --import tsx --test --test-concurrency=1 packages/agent-runtime/tests/*.test.mjs",
    "test:web": "pnpm --prefix frontend/web test",
    "test:all": "pnpm test && pnpm run test:runtime && pnpm run test:web",
    "build:test": "node --max-semi-space-size=16 --max-old-space-size=1024 ./node_modules/typescript/bin/tsc -p tsconfig.test.json",
    "verify": "python app/scripts/verify_all.py",
    "judge": "node scripts/judge.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "guard:layout": "node scripts/guard/layout.mjs",
    "guard:layout:enforce": "node scripts/guard/layout.mjs --enforce",
    "redis:up": "docker compose -f docker/docker-compose.dev.yml up -d redis",
    "redis:down": "docker compose -f docker/docker-compose.dev.yml down",
    "redis:logs": "docker compose -f docker/docker-compose.dev.yml logs -f redis",
    "dev:up": "docker compose -f docker/docker-compose.dev.yml up --build -d",
    "dev:down": "docker compose -f docker/docker-compose.dev.yml down",
    "start:worker": "node dist/backend/scripts/run-pipeline-worker.js",
    "test:pipeline:e2e": "node backend/scripts/test-pipeline-e2e.mjs",
    "test:pipeline:recovery": "node backend/scripts/test-pipeline-recovery.mjs",
    "test:pipeline:checkpoint-recovery": "node backend/scripts/test-pipeline-checkpoint-recovery.mjs",
    "test:pipeline:refinement-recovery": "node backend/scripts/test-pipeline-refinement-recovery.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@strands-agents/sdk": "^1.17.0",
    "@tavily/core": "^0.7.11",
    "ai": "^7.0.97",
    "ajv": "^8.20.0",
    "bullmq": "^6.3.4",
    "dotenv": "^18.0.3",
    "ioredis": "^6.0.0",
    "openai": "^6.49.0",
    "zod": "^4.6.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "24.0.4",
    "tsx": "^4.23.15",
    "typescript": "5.8.3",
    "undici-types": "7.8.0"
  }
}
